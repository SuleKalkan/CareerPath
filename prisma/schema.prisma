generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique @db.VarChar(320)
  displayName   String            @map("display_name") @db.VarChar(160)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  courseImports CourseImport[]
  documents     documents[]
  roadmaps      Roadmap[]
  savedJobs     SavedJob[]
  courses       StudentCourse[]
  interests     StudentInterest[]
  profile       StudentProfile?
  skills        StudentSkill[]

  @@map("users")
}

model StudentProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  university         String?   @db.VarChar(200)
  college            String?   @db.VarChar(200)
  concentration      String?   @db.VarChar(160)
  academicLevel      String?   @map("academic_level") @db.VarChar(80)
  expectedGraduation DateTime? @map("expected_graduation") @db.Date
  targetCareerId     String?   @map("target_career_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  targetCareer       Career?   @relation(fields: [targetCareerId], references: [id])
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetCareerId])
  @@map("student_profiles")
}

model Skill {
  id                String                  @id @default(uuid()) @db.Uuid
  name              String                  @db.VarChar(120)
  normalizedName    String                  @unique @map("normalized_name") @db.VarChar(120)
  description       String?
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  preparationSteps  CareerPreparationStep[]
  careerSkills      CareerSkill[]
  courseSkills      CourseSkill[]
  jobSkills         JobSkill[]
  roadmapActivities RoadmapActivity[]
  studentSkills     StudentSkill[]

  @@map("skills")
}

model Interest {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(120)
  normalizedName String            @unique @map("normalized_name") @db.VarChar(120)
  students       StudentInterest[]

  @@map("interests")
}

model StudentSkill {
  userId      String              @map("user_id") @db.Uuid
  skillId     String              @map("skill_id") @db.Uuid
  proficiency StudentProficiency?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  skill       Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
  @@map("student_skills")
}

model StudentInterest {
  userId     String   @map("user_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
  @@map("student_interests")
}

model Career {
  id                    String                  @id @default(uuid()) @db.Uuid
  title                 String                  @db.VarChar(160)
  normalizedTitle       String                  @unique @map("normalized_title") @db.VarChar(160)
  description           String
  responsibilities      String[]                @default([])
  educationExpectations String                  @map("education_expectations")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  preparationSteps      CareerPreparationStep[]
  careerSkills          CareerSkill[]
  roadmaps              Roadmap[]
  profiles              StudentProfile[]

  @@map("careers")
}

model CareerSkill {
  careerId   String  @map("career_id") @db.Uuid
  skillId    String  @map("skill_id") @db.Uuid
  importance Decimal @default(1.00) @db.Decimal(5, 2)
  career     Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill      Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([careerId, skillId])
  @@index([skillId])
  @@map("career_skills")
}

model CareerPreparationStep {
  id          String            @id @default(uuid()) @db.Uuid
  careerId    String            @map("career_id") @db.Uuid
  skillId     String?           @map("skill_id") @db.Uuid
  title       String            @db.VarChar(160)
  description String
  category    ActivityCategory  @default(CAREER_PREP)
  sequence    Int               @default(0)
  career      Career            @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill       Skill?            @relation(fields: [skillId], references: [id])
  activities  RoadmapActivity[]

  @@unique([careerId, sequence])
  @@index([skillId])
  @@map("career_preparation_steps")
}

model Roadmap {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  careerId   String            @map("career_id") @db.Uuid
  title      String            @db.VarChar(160)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities RoadmapActivity[]
  career     Career            @relation(fields: [careerId], references: [id])
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, careerId])
  @@index([careerId])
  @@map("roadmaps")
}

model RoadmapActivity {
  id                String                 @id @default(uuid()) @db.Uuid
  roadmapId         String                 @map("roadmap_id") @db.Uuid
  preparationStepId String?                @map("preparation_step_id") @db.Uuid
  skillId           String?                @map("skill_id") @db.Uuid
  studentCourseId   String?                @unique @map("student_course_id") @db.Uuid
  title             String                 @db.VarChar(100)
  category          ActivityCategory
  duration          String                 @default("Flexible") @db.VarChar(40)
  description       String                 @db.VarChar(240)
  status            ActivityStatus         @default(NOT_STARTED)
  position          Int                    @default(0)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  preparationStep   CareerPreparationStep? @relation(fields: [preparationStepId], references: [id])
  roadmap           Roadmap                @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skill             Skill?                 @relation(fields: [skillId], references: [id])
  studentCourse     StudentCourse?         @relation(fields: [studentCourseId], references: [id])

  @@unique([roadmapId, preparationStepId])
  @@index([roadmapId, position])
  @@index([skillId, status])
  @@map("roadmap_activities")
}

model Course {
  id               String            @id @default(uuid()) @db.Uuid
  institutionName  String            @map("institution_name") @db.VarChar(200)
  courseCode       String?           @map("course_code") @db.VarChar(80)
  title            String            @db.VarChar(200)
  identityKey      String            @map("identity_key") @db.VarChar(240)
  credits          Decimal?          @db.Decimal(4, 1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  skills           CourseSkill[]
  extractedCourses ExtractedCourse[] @relation("RecognizedCourse")
  studentCourses   StudentCourse[]

  @@unique([institutionName, identityKey])
  @@index([courseCode])
  @@map("courses")
}

model CourseSkill {
  courseId String @map("course_id") @db.Uuid
  skillId  String @map("skill_id") @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
  @@index([skillId])
  @@map("course_skills")
}

model CourseImport {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  fileName         String             @map("file_name") @db.VarChar(255)
  mediaType        String             @map("media_type") @db.VarChar(120)
  storageKey       String             @unique @map("storage_key") @db.VarChar(500)
  status           CourseImportStatus @default(UPLOADED)
  errorMessage     String?            @map("error_message")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  document_id      String?            @unique @db.Uuid
  documents        documents?         @relation(fields: [document_id], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractedCourses ExtractedCourse[]
  studentCourses   StudentCourse[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("course_imports")
}

model ExtractedCourse {
  id                 String                      @id @default(uuid()) @db.Uuid
  courseImportId     String                      @map("course_import_id") @db.Uuid
  recognizedCourseId String?                     @map("recognized_course_id") @db.Uuid
  studentCourseId    String?                     @unique @map("student_course_id") @db.Uuid
  rawText            String                      @map("raw_text")
  institutionName    String?                     @map("institution_name") @db.VarChar(200)
  courseCode         String?                     @map("course_code") @db.VarChar(80)
  courseTitle        String?                     @map("course_title") @db.VarChar(200)
  creditHours        Decimal?                    @map("credit_hours") @db.Decimal(4, 1)
  term               String?                     @db.VarChar(80)
  grade              String?                     @db.VarChar(40)
  confidence         Decimal?                    @db.Decimal(5, 4)
  reviewStatus       ExtractedCourseReviewStatus @default(PENDING) @map("review_status")
  reviewNote         String?                     @map("review_note")
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  courseImport       CourseImport                @relation(fields: [courseImportId], references: [id], onDelete: Cascade)
  recognizedCourse   Course?                     @relation("RecognizedCourse", fields: [recognizedCourseId], references: [id])
  studentCourse      StudentCourse?              @relation(fields: [studentCourseId], references: [id])

  @@index([courseImportId, reviewStatus])
  @@index([recognizedCourseId])
  @@map("extracted_courses")
}

model StudentCourse {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  courseId         String?                @map("course_id") @db.Uuid
  sourceImportId   String?                @map("source_import_id") @db.Uuid
  institutionName  String?                @map("institution_name") @db.VarChar(200)
  courseCode       String?                @map("course_code") @db.VarChar(80)
  courseTitle      String                 @map("course_title") @db.VarChar(200)
  credits          Decimal?               @db.Decimal(4, 1)
  term             String?                @db.VarChar(80)
  grade            String?                @db.VarChar(40)
  deduplicationKey String                 @map("deduplication_key") @db.VarChar(300)
  completionStatus CourseCompletionStatus @default(COMPLETED) @map("completion_status")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  extraction       ExtractedCourse?
  roadmapActivity  RoadmapActivity?
  course           Course?                @relation(fields: [courseId], references: [id])
  sourceImport     CourseImport?          @relation(fields: [sourceImportId], references: [id])
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deduplicationKey])
  @@index([userId, completionStatus])
  @@index([courseId])
  @@map("student_courses")
}

model Employer {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(200)
  normalizedName String           @unique @map("normalized_name") @db.VarChar(200)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  jobs           JobOpportunity[]

  @@map("employers")
}

model JobOpportunity {
  id          String     @id @default(uuid()) @db.Uuid
  employerId  String     @map("employer_id") @db.Uuid
  title       String     @db.VarChar(200)
  description String
  location    String     @db.VarChar(200)
  type        JobType
  status      JobStatus  @default(ACTIVE)
  postedAt    DateTime   @default(now()) @map("posted_at") @db.Timestamptz(6)
  closesAt    DateTime?  @map("closes_at") @db.Timestamptz(6)
  externalUrl String?    @map("external_url") @db.VarChar(2048)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employer    Employer   @relation(fields: [employerId], references: [id])
  skills      JobSkill[]
  savedBy     SavedJob[]

  @@index([status, postedAt])
  @@index([employerId])
  @@map("job_opportunities")
}

model JobSkill {
  jobId      String         @map("job_id") @db.Uuid
  skillId    String         @map("skill_id") @db.Uuid
  isRequired Boolean        @default(true) @map("is_required")
  importance Decimal        @default(1.00) @db.Decimal(5, 2)
  job        JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model SavedJob {
  userId  String         @map("user_id") @db.Uuid
  jobId   String         @map("job_id") @db.Uuid
  savedAt DateTime       @default(now()) @map("saved_at") @db.Timestamptz(6)
  job     JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([jobId])
  @@map("saved_jobs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model documents {
  id             String          @id @db.Uuid
  user_id        String          @db.Uuid
  type           document_type
  file_name      String          @db.VarChar(255)
  media_type     String          @db.VarChar(120)
  size_bytes     BigInt
  storage_bucket String          @db.VarChar(63)
  storage_key    String          @db.VarChar(500)
  sha256         String?         @db.Char(64)
  status         document_status @default(PENDING_UPLOAD)
  error_message  String?
  uploaded_at    DateTime?       @db.Timestamptz(6)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  course_imports CourseImport?
  users          User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([storage_bucket, storage_key])
  @@index([user_id, status])
  @@index([user_id, type, created_at])
}

enum StudentProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("student_proficiency")
}

enum ActivityCategory {
  SKILL
  COURSE
  PROJECT
  CAREER_PREP
  NETWORKING
  TRANSFER_CREDIT
  OTHER

  @@map("activity_category")
}

enum ActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("activity_status")
}

enum CourseCompletionStatus {
  COMPLETED
  TRANSFERRED
  IN_PROGRESS

  @@map("course_completion_status")
}

enum CourseImportStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  CONFIRMED
  FAILED

  @@map("course_import_status")
}

enum ExtractedCourseReviewStatus {
  PENDING
  RECOGNIZED
  UNRECOGNIZED
  CONFIRMED
  REMOVED

  @@map("extracted_course_review_status")
}

enum JobType {
  INTERNSHIP
  CO_OP
  ENTRY_LEVEL
  FULL_TIME
  PART_TIME
  CONTRACT
  OTHER

  @@map("job_type")
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED

  @@map("job_status")
}

enum document_status {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum document_type {
  RESUME
  TRANSCRIPT
  OTHER
}
